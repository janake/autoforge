{
  "name": "autoforge",
  "private": true,
  "version": "0.1.14",
  "description": "AI-assisted self-evolving application platform",
  "workspaces": [
    "apps/*",
    "services/provider-proxy",
    "services/worker"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @autoforge/web",
    "build:web": "npm run build --workspace @autoforge/web",
    "typecheck:web": "npm run typecheck --workspace @autoforge/web",
    "dev:backend": "mvn -f services/backend/pom.xml spring-boot:run",
    "test:backend": "mvn -q -f services/backend/pom.xml test",
    "build:backend": "mvn -q -f services/backend/pom.xml package",
    "test:provider-proxy": "npm run test --workspace @autoforge/provider-proxy",
    "dev:worker": "npm run dev --workspace @autoforge/worker",
    "jira:dry-run": "node ops/jira/generate-import-plan.mjs",
    "jira:import:dry-run": "node ops/jira/import-plan.mjs",
    "jira:import:check": "node ops/jira/import-plan.mjs --check-existing",
    "jira:import": "node ops/jira/import-plan.mjs --apply"
  }
}
