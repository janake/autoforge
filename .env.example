# Local backend port on the host.
BACKEND_PORT=8080

# Local frontend port on the host.
WEB_PORT=8081

# SQLite database file path inside the backend container.
AUTOFORGE_DB_PATH=/data/autoforge.sqlite

# Optional GitHub metadata used by later MVP job tasks.
AUTOFORGE_GITHUB_TOKEN=
AUTOFORGE_GITHUB_OWNER=<github-owner>
AUTOFORGE_GITHUB_REPO=autoforge
AUTOFORGE_BASE_BRANCH=main

# Allowed browser origins for the backend CORS policy.
AUTOFORGE_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional overrides for the web runtime config.
API_BASE_URL=http://localhost:8080/api
KEYCLOAK_URL=https://kc.prodet.org
KEYCLOAK_REALM=autoforge
KEYCLOAK_CLIENT_ID=autoforge-web
