BACKEND_IMAGE=ghcr.io/<registry-owner>/autoforge/backend
BACKEND_IMAGE_TAG=main
BACKEND_HOST_PORT=8080
BACKEND_CONTAINER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseSerialGC
AI_PROVIDER_PROXY_BASE_URL=http://openrouter-proxy:8080/v1
AI_PROVIDER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_PROXY_IMAGE=ghcr.io/<registry-owner>/autoforge/openrouter-proxy
OPENROUTER_PROXY_IMAGE_TAG=main
PROVIDER_PROXY_PORT=8080
OPENROUTER_API_KEY_SECRET_OCID=<vault-secret-ocid>
OPENROUTER_DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_ALLOWED_MODELS=google/gemma-4-26b-a4b-it:free
OPENROUTER_MAX_COMPLETION_TOKENS=32768
OPENROUTER_MAX_REQUEST_BYTES=10485760
OPENROUTER_SITE_URL=https://oci.prodet.org
OPENROUTER_APP_NAME=Autoforge
KEYCLOAK_ISSUER_URI=https://kc.prodet.org/realms/<keycloak-realm>
