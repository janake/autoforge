BACKEND_IMAGE=ghcr.io/<registry-owner>/autoforge/backend
BACKEND_IMAGE_TAG=main
BACKEND_HOST_PORT=8080
BACKEND_CONTAINER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseSerialGC
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode
OPENCODE_IMAGE_TAG=latest
OPENCODE_SERVER_URL=http://opencode:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
OPENCODE_SERVER_PORT=4096
OPENAI_API_KEY=<provider-api-key>
