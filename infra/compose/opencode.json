{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "provider": {
    "autoforge-openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Autoforge OpenRouter Proxy",
      "options": {
        "baseURL": "http://openrouter-proxy:8080/v1",
        "apiKey": "proxy-auth-placeholder"
      },
      "models": {
        "deepseek/deepseek-v4-flash:free": {
          "name": "DeepSeek V4 Flash Free via OpenRouter Proxy",
          "maxTokens": 2048
        }
      }
    }
  },
  "share": "disabled",
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  }
}
