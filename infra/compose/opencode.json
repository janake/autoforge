{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "provider": {
    "autoforge-openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Autoforge OpenRouter Proxy",
      "options": {
        "baseURL": "http://openrouter-proxy:8080/v1",
        "apiKey": "proxy-auth-placeholder"
      },
      "models": {
        "qwen/qwen3.6-plus": {
          "name": "Qwen3.6 Plus via OpenRouter Proxy"
        }
      }
    }
  },
  "share": "disabled",
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  }
}
