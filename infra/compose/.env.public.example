WEB_IMAGE=ghcr.io/<registry-owner>/autoforge/web
WEB_IMAGE_TAG=main
API_IMAGE=ghcr.io/<registry-owner>/autoforge/api-gateway
API_IMAGE_TAG=main
GATEWAY_DOMAIN=oci.prodet.org, api.oci.prodet.org
BACKEND_UPSTREAM=<private-backend-ip>:8080
API_UPSTREAM=api:8080
WEB_UPSTREAM=web:8080
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
KEYCLOAK_URL=https://kc.prodet.org
KEYCLOAK_REALM=<keycloak-realm>
KEYCLOAK_CLIENT_ID=autoforge-web
# Cloudflare DNS sync is optional but supported by the public deploy flow.
# The workflow uploads these values to the public host if both are set.
CLOUDFLARE_ORIGIN_HOST=<public-ssh-host-or-ip>
CLOUDFLARE_RECORDS=oci.prodet.org, api.oci.prodet.org
